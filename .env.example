# Copy this file to ".env" and adjust values locally.
# Never commit a real .env.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=formation_platform
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me

JWT_SECRET=change_me_use_at_least_32_random_characters
JWT_EXPIRATION_MS=28800000

# Demo logins — set real values only in your local .env (never commit .env)
DEMO_ADMIN_EMAIL=admin@formalearn.tn
DEMO_ADMIN_PASSWORD=
DEMO_LEARNER_EMAIL=apprenant@formalearn.tn
DEMO_LEARNER_PASSWORD=
DEMO_LEARNER2_EMAIL=apprenant2@formalearn.tn
DEMO_LEARNER3_EMAIL=apprenant3@formalearn.tn

ML_BASE_URL=http://localhost:8000

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Hôte seulement (le conteneur écoute toujours 8080). Si Spring tourne déjà en local, utiliser 8082.
BACKEND_HOST_PORT=8080
